      "updatedAt": "Sun Aug 11 2024 19:11:05 GMT+0000 (Coordinated Universal Time)",
      "publishedAt": "Mon Aug 12 2024 02:06:44 GMT+0000 (Coordinated Universal Time)",
      "question": "<p>What does \"RFI\" stand for in construction terms?</p>",
      "answer": "<p>Request For Information.</p>",
      "type": "General B"
    },
    {
      "id": "66b90ccef8f1d06c1592f8e3",
      "slug": "60",
      "name": "60",
