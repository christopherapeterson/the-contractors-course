      "updatedAt": "Sun Aug 11 2024 19:11:10 GMT+0000 (Coordinated Universal Time)",
      "publishedAt": "Mon Aug 12 2024 02:06:44 GMT+0000 (Coordinated Universal Time)",
      "question": "<p>What is \"Net Profit\"?</p>",
      "answer": "<p>The remaining income after all expenses, including overhead and indirect costs, have been deducted from gross profit.</p>",
      "type": "Law and Business"
    },
    {
      "id": "66b90ccf42a15fc71d07e572",
