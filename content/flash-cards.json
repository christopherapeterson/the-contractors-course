      "updatedAt": "Sun Aug 11 2024 19:11:10 GMT+0000 (Coordinated Universal Time)",
      "publishedAt": "Mon Aug 12 2024 02:06:44 GMT+0000 (Coordinated Universal Time)",
      "question": "<p>What is the \"Contract Price\"?</p>",
      "answer": "<p>The total amount agreed upon for completing a construction project, as specified in the contract.</p>",
      "type": "Law and Business"
    },
    {
      "id": "66b90ccecdcfe64dae91affb",
