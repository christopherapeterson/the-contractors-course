      "updatedAt": "Sun Aug 11 2024 19:11:11 GMT+0000 (Coordinated Universal Time)",
      "publishedAt": "Mon Aug 12 2024 02:06:44 GMT+0000 (Coordinated Universal Time)",
      "question": "<p>Explain \"Bid Peddling.\"</p>",
      "answer": "<p>The unethical practice of a contractor reducing their bid price after being awarded a project to undercut competitors.</p>",
      "type": "Law and Business"
    },
    {
      "id": "66b90ccaae3d181a226f3543",
      "slug": "7",
      "name": "7",
      "archived": false,
      "draft": false,
      "createdAt": "Sun Aug 11 2024 19:11:06 GMT+0000 (Coordinated Universal Time)",
      "updatedAt": "Sun Aug 11 2024 19:11:06 GMT+0000 (Coordinated Universal Time)",
      "publishedAt": "Mon Aug 12 2024 02:06:44 GMT+0000 (Coordinated Universal Time)",
      "question": "<p>Explain \"Retainage\" or \"Retention.\"</p>",
      "answer": "<p>A percentage of payment withheld until project completion to ensure work quality.</p>",
      "type": "General B"
    },
