      "updatedAt": "Sun Aug 11 2024 19:11:11 GMT+0000 (Coordinated Universal Time)",
      "publishedAt": "Mon Aug 12 2024 02:06:44 GMT+0000 (Coordinated Universal Time)",
      "question": "<p>Define \"Bid Shopping.\"</p>",
      "answer": "<p>The practice of revealing bid prices to other subcontractors to obtain lower bids, often considered unethical.</p>",
      "type": "Law and Business"
